{
  "description": "Shared conformance vectors. Every implementation must map unix seconds to the AC fields below and back. AC year = CE year (astronomical numbering, 1 BCE = year 0) minus 1970. Unix time ignores leap seconds.",
  "unix": [
    { "unix": 0, "ac": { "year": 0, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0 }, "ce_year": 1970, "note": "Unix epoch" },
    { "unix": -1, "ac": { "year": -1, "month": 12, "day": 31, "hour": 23, "minute": 59, "second": 59 }, "ce_year": 1969, "note": "last second before the epoch" },
    { "unix": -14182940, "ac": { "year": -1, "month": 7, "day": 20, "hour": 20, "minute": 17, "second": 40 }, "ce_year": 1969, "note": "Apollo 11 landing" },
    { "unix": 946684800, "ac": { "year": 30, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0 }, "ce_year": 2000, "note": "year 2000" },
    { "unix": 951782400, "ac": { "year": 30, "month": 2, "day": 29, "hour": 0, "minute": 0, "second": 0 }, "ce_year": 2000, "note": "2000 is a leap year (30 AC is not divisible by 4)" },
    { "unix": 1000000000, "ac": { "year": 31, "month": 9, "day": 9, "hour": 1, "minute": 46, "second": 40 }, "ce_year": 2001, "note": "Unix time reaches 1 billion" },
    { "unix": 1703376000, "ac": { "year": 53, "month": 12, "day": 24, "hour": 0, "minute": 0, "second": 0 }, "ce_year": 2023, "note": "annocomputatri.net launched" },
    { "unix": 1792852108, "ac": { "year": 56, "month": 10, "day": 24, "hour": 14, "minute": 28, "second": 28 }, "ce_year": 2026, "note": "value shown on annocomputatri.net, observed 2026-10-24" },
    { "unix": 2147483647, "ac": { "year": 68, "month": 1, "day": 19, "hour": 3, "minute": 14, "second": 7 }, "ce_year": 2038, "note": "32-bit overflow" },
    { "unix": 2147483648, "ac": { "year": 68, "month": 1, "day": 19, "hour": 3, "minute": 14, "second": 8 }, "ce_year": 2038, "note": "first second after 32-bit overflow" },
    { "unix": -2208988800, "ac": { "year": -70, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0 }, "ce_year": 1900, "note": "1900 is not a leap year" },
    { "unix": -62135596800, "ac": { "year": -1969, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0 }, "ce_year": 1, "note": "0001-01-01 CE" },
    { "unix": -62167219200, "ac": { "year": -1970, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0 }, "ce_year": 0, "note": "astronomical year 0 (1 BCE), a leap year" },
    { "unix": 253402300799, "ac": { "year": 8029, "month": 12, "day": 31, "hour": 23, "minute": 59, "second": 59 }, "ce_year": 9999, "note": "9999-12-31 23:59:59 CE" }
  ],
  "leap_years": [
    { "ac_year": 30, "ce_year": 2000, "leap": true },
    { "ac_year": -70, "ce_year": 1900, "leap": false },
    { "ac_year": 52, "ce_year": 2022, "leap": false, "note": "52 is divisible by 4 but 2022 is not a leap year; leap rules follow the CE year" },
    { "ac_year": 54, "ce_year": 2024, "leap": true, "note": "54 is not divisible by 4 but 2024 is a leap year" },
