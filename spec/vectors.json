  ],
  "format": [
    { "ac": { "year": 56, "month": 10, "day": 24, "hour": 14, "minute": 28, "second": 28 }, "universal": "⏀ 56-10-24 14:28:28", "dual": "2026 CE / 56 AC" },
    { "ac": { "year": -1, "month": 7, "day": 20, "hour": 20, "minute": 17, "second": 40 }, "universal": "⏀ -1-07-20 20:17:40", "dual": "1969 CE / -1 AC" },
    { "ac": { "year": 0, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0 }, "universal": "⏀ 0-01-01 00:00:00", "dual": "1970 CE / 0 AC" },
    { "ac": { "year": -1970, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0 }, "universal": "⏀ -1970-01-01 00:00:00", "dual": "1 BCE / -1970 AC" }
